limit_req_zone $binary_remote_addr zone=web_per_ip:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=8r/s;
limit_req_zone $binary_remote_addr zone=uploads_per_ip:10m rate=15r/s;
limit_conn_zone $binary_remote_addr zone=connections_per_ip:10m;

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Preserve the browser-facing scheme supplied by Caddy. Falling back to
# $scheme keeps the gateway usable when it is called directly in development.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  '' $scheme;
}

upstream yakuku_web {
  server web:3000;
  keepalive 32;
}

upstream yakuku_api {
  server api:4000;
  keepalive 32;
}

server {
  listen 8080 default_server;
  server_name _;
  server_tokens off;

  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  client_max_body_size 13m;
  client_body_timeout 120s;
  client_header_timeout 10s;
  keepalive_timeout 15s;
  send_timeout 120s;

  limit_conn connections_per_ip 30;
  limit_conn_status 429;
  limit_req_status 429;

  location /api/ {
    limit_req zone=api_per_ip burst=30 nodelay;

    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_connect_timeout 3s;
    proxy_read_timeout 60s;
    proxy_send_timeout 120s;
    proxy_pass http://yakuku_api;
  }

  location /uploads/ {
    limit_req zone=uploads_per_ip burst=60 nodelay;

    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_set_header Host $host;
    proxy_set_header Referer $http_referer;
    proxy_set_header Sec-Fetch-Dest $http_sec_fetch_dest;
    proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_pass http://yakuku_api;
  }

  location / {
    limit_req zone=web_per_ip burst=80 nodelay;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 3s;
    proxy_read_timeout 60s;
    proxy_pass http://yakuku_web;
  }
}
