NODE_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# API
API_PORT=4000
APP_URL=http://localhost:3000
JWT_SECRET=change-me-in-local-env
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
UPLOAD_DIR=uploads

# Gmail SMTP
# Gmail 계정은 일반 비밀번호가 아니라 앱 비밀번호를 사용하세요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com

# Server error alert (500 에러, KBO 동기화 실패, 프로세스 크래시 → 메일)
# production에서는 기본으로 켜집니다. 수신자를 비우면 SMTP_USER로 보냅니다.
# ERROR_ALERT_ENABLED=true
# ERROR_ALERT_EMAIL=admin@example.com
# ERROR_ALERT_COOLDOWN_MS=600000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=yakuku_yaru
MYSQL_USER=yakuku
MYSQL_PASSWORD=yakuku_password
MYSQL_ROOT_PASSWORD=root_password
