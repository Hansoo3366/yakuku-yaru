# Yakuku Yaru — KBO 크롤링 (서버 호스트 crontab)
# 설치:
#   cd ~/yakuku-yaru
#   sed "s|PROJECT_DIR|$(pwd)|g" scripts/kbo-sync/crontab.example | crontab -
#   crontab -l
#
# 예) PROJECT_DIR=/home/hanso3366/yakuku-yaru
# 아래 시각은 모두 KST (서버가 UTC여도 TZ로 맞춤)

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
TZ=Asia/Seoul

# 매일 06:00 KST — 주간 일정
0 6 * * * cd PROJECT_DIR && ./scripts/kbo-sync/week.sh

# 주간 게임센터 — 선발·라인업 사전 보강
10 6 * * * cd PROJECT_DIR && GC_MODE=week ./scripts/kbo-sync/game-center.sh

# 매일 06:20 KST — 팀 순위
20 6 * * * cd PROJECT_DIR && ./scripts/kbo-sync/standings.sh

# 당일 일정/스코어 — KBO 일정 API
0 8,11,12 * * * cd PROJECT_DIR && ./scripts/kbo-sync/today.sh
30 10-12 * * * cd PROJECT_DIR && ./scripts/kbo-sync/today.sh
0,30 13-23 * * * cd PROJECT_DIR && ./scripts/kbo-sync/today.sh

# 당일 선발·라인업 — KBO 게임센터
5 8,11,12 * * * cd PROJECT_DIR && ./scripts/kbo-sync/game-center.sh
35 10-12 * * * cd PROJECT_DIR && ./scripts/kbo-sync/game-center.sh
5,35 13-23 * * * cd PROJECT_DIR && ./scripts/kbo-sync/game-center.sh

# 16:10~23:40 KST — 낮 경기 종료/저녁 경기 종료 후 팀 순위 백업 갱신
10,40 16-23 * * * cd PROJECT_DIR && ./scripts/kbo-sync/standings.sh

# 자정 직후 — 막판 경기 반영 순위
5 0 * * * cd PROJECT_DIR && ./scripts/kbo-sync/standings.sh

# 새벽 1시대 — 저장된 일정/순위 DB 기준 시즌 예상 순위 저장
30 1 * * * cd PROJECT_DIR && ./scripts/kbo-sync/projection.sh

# 매주 월요일 07:10 KST — 선수 마스터(타율·OPS·생년월일)
10 7 * * 1 cd PROJECT_DIR && ./scripts/kbo-sync/weekly.sh

# 매월 1일 06:30 KST — 당월 일정 (week/game-center/standings와 lock 충돌 방지)
30 6 1 * * cd PROJECT_DIR && ./scripts/kbo-sync/month.sh

# 매년 3월 1일 06:50 KST — 시즌 전체 일정 (week/month와 lock 충돌 방지)
50 6 1 3 * cd PROJECT_DIR && ./scripts/kbo-sync/season.sh
