# Yakuku Yaru — KBO 크롤링 (서버 호스트 crontab)
# 설치: PROJECT_DIR을 실제 경로로 바꾼 뒤 crontab -e 에 붙여넣기
#
# 예) PROJECT_DIR=/home/ubuntu/yakuku-yaru

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# 매일 06:00 KST — 일정(week) + 팀 순위
0 6 * * * cd PROJECT_DIR && ./scripts/kbo-sync/daily.sh

# 당일 일정 + 선발·라인업 (KST)
0 8 * * * cd PROJECT_DIR && ./scripts/kbo-sync/live.sh
30 10 * * * cd PROJECT_DIR && ./scripts/kbo-sync/live.sh
0 13 * * * cd PROJECT_DIR && ./scripts/kbo-sync/live.sh
30 15 * * * cd PROJECT_DIR && ./scripts/kbo-sync/live.sh
0 17 * * * cd PROJECT_DIR && ./scripts/kbo-sync/live.sh
30 18 * * * cd PROJECT_DIR && ./scripts/kbo-sync/live.sh
0 20 * * * cd PROJECT_DIR && ./scripts/kbo-sync/live.sh
30 21 * * * cd PROJECT_DIR && ./scripts/kbo-sync/live.sh

# 매주 월요일 06:30 KST — 선수 마스터(타율·OPS·생년월일)
30 6 * * 1 cd PROJECT_DIR && ./scripts/kbo-sync/weekly.sh

# 매월 1일 06:00 KST — 당월 일정
0 6 1 * * cd PROJECT_DIR && ./scripts/kbo-sync/month.sh

# 매년 3월 1일 06:00 KST — 시즌 전체 일정
0 6 1 3 * cd PROJECT_DIR && ./scripts/kbo-sync/season.sh
