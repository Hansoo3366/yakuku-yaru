#!/usr/bin/env bash
# 배포 전용 사용자(deploy)의 SSH 키로 실행할 수 있는 유일한 명령.
# authorized_keys 의 command= 로 강제된다. 받은 명령이 "deploy <커밋 SHA> <GitHub 사용자>" 꼴일 때만
# 운영 계정으로 넘어가 remote-deploy.sh 를 실행한다. 셸, 포트 포워딩, 다른 명령은 쓸 수 없다.
# stdin 첫 줄은 ghcr 로그인 토큰이다.
#
# 설치: sudo bash scripts/deploy/setup-deploy-user.sh (이 파일을 /usr/local/bin 에 root 소유로 복사한다)
set -euo pipefail

CONF=/etc/yakuku-deploy.conf
IMAGE_PREFIX=ghcr.io/hansoo3366/yakuku-yaru
SHA_PATTERN='^[0-9a-f]{40}$'
ACTOR_PATTERN='^[A-Za-z0-9-]+(\[bot\])?$'

# RUN_AS(운영 계정), DEPLOY_PATH(저장소 경로). root 소유 파일이라 그대로 읽는다.
# shellcheck source=/dev/null
source "$CONF"

if [[ "$(id -un)" != "$RUN_AS" ]]; then
  command_line="${SSH_ORIGINAL_COMMAND:-}"
  read -r action sha actor extra <<< "$command_line"
  if [[ "$command_line" == *$'\n'* || "$action" != deploy || ! "$sha" =~ $SHA_PATTERN || ! "$actor" =~ $ACTOR_PATTERN || -n "$extra" ]]; then
    echo "허용되지 않은 명령입니다." >&2
    exit 1
  fi
  exec sudo -n -H -u "$RUN_AS" /usr/local/bin/yakuku-deploy "$sha" "$actor"
fi

if [[ $# -ne 2 || ! "$1" =~ $SHA_PATTERN || ! "$2" =~ $ACTOR_PATTERN ]]; then
  echo "잘못된 인자입니다." >&2
  exit 1
fi

read -r GHCR_TOKEN
cd "$DEPLOY_PATH"
# 배포 스크립트도 최신 main 의 것을 쓴다.
git fetch origin main
git reset --hard origin/main

export DEPLOY_PATH GHCR_TOKEN
export GHCR_USER="$2" SENTRY_RELEASE="$1"
export API_IMAGE="${IMAGE_PREFIX}-api:$1" WEB_IMAGE="${IMAGE_PREFIX}-web:$1"
exec bash scripts/deploy/remote-deploy.sh
