NODE_ENV=production

# Public URLs
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN/api
NEXT_PUBLIC_CONTACT_EMAIL=contact@YOUR_DOMAIN

# Optional reverse proxy domain.
# Example: yakuku-yaru.duckdns.org
# Set COMPOSE_PROFILES=proxy after DNS is connected.
# COMPOSE_PROFILES=proxy
APP_DOMAIN=YOUR_DOMAIN

# API
APP_URL=https://YOUR_DOMAIN
# 쉼표로 구분한 추가 허용 출처. 보통 APP_URL 하나면 충분합니다.
# CORS_ORIGINS=https://admin.YOUR_DOMAIN
## KBO가 기본 호환 프로필을 차단할 때만 브라우저 User-Agent로 재정의합니다.
# KBO_USER_AGENT=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Gmail SMTP
# Gmail 계정은 일반 비밀번호가 아니라 앱 비밀번호를 사용하세요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com

# MySQL
MYSQL_DATABASE=yakuku_yaru
MYSQL_USER=yakuku
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
